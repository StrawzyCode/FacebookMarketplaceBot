# Copy this file to .env and fill it in. .env is git-ignored, so your key stays on your computer.

# REQUIRED: your Anthropic API key, from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Where to search when your prompt doesn't say (city + state, or a ZIP/postal code)
DEFAULT_LOCATION=
# How far to search (miles) when your prompt doesn't say
DEFAULT_RADIUS_MILES=25

# Optional: Facebook's ID for your Marketplace city. Open Marketplace, pick your city,
# then click any category: the URL looks like facebook.com/marketplace/<THIS PART>/vehicles
# Leave blank to use the location saved on your Facebook account.
FB_LOCATION_ID=

# How thorough each search is
MAX_RESULTS_PER_QUERY=80     # listings collected per search query
MAX_DEEP_CHECKS=40           # listings opened and inspected by Claude (photos + full description)
IMAGES_PER_LISTING=3         # photos per listing Claude looks at

# Claude model used for every step
CLAUDE_MODEL=claude-opus-5-5
# If Claude's safety filters decline a request, retry it on a fallback model automatically
CLAUDE_REFUSAL_FALLBACK=true

# Browser
HEADLESS=false               # true hides the browser window (Facebook is more likely to block headless browsers)
BROWSER_CHANNEL=             # set to "chrome" to use your installed Google Chrome
