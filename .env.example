# Copy this file to .env and change what you like. Everything here is optional.

# Where to search when your prompt doesn't say (city + state, or a ZIP/postal code)
DEFAULT_LOCATION=
# How far to search (miles) when your prompt doesn't say
DEFAULT_RADIUS_MILES=25

# How listings are matched. All free except "claude".
#   auto   = free local AI if Ollama is installed, otherwise free keyword matching (recommended)
#   rules  = free keyword matching only (instant, no extra install)
#   ollama = free local AI only (see "Smarter matching (free)" in the README)
#   claude = Anthropic's Claude (paid, needs ANTHROPIC_API_KEY)
AI_BACKEND=auto
OLLAMA_MODEL=gemma3:4b       # gemma3:12b is smarter if your computer has 16 GB+ of memory
OLLAMA_URL=http://localhost:11434

# Optional: Facebook's ID for your Marketplace city. Open Marketplace, pick your city,
# then click any category: the URL looks like facebook.com/marketplace/<THIS PART>/vehicles
# Leave blank to use the location saved on your Facebook account.
FB_LOCATION_ID=

# How thorough each search is (blank = sensible default for the matching mode)
MAX_RESULTS_PER_QUERY=80     # listings collected per search phrase
MAX_DEEP_CHECKS=             # listings opened and checked in full (default 40, or 15 with local AI)
IMAGES_PER_LISTING=          # photos per listing the local AI looks at (default 2)

# Browser
HEADLESS=false               # true hides the browser window (Facebook is more likely to block hidden browsers)
BROWSER_CHANNEL=             # set to "chrome" to use your installed Google Chrome

# Only needed if AI_BACKEND=claude (paid)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
